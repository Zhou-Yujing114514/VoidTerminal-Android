function roomTitle(type, id) {
  if (type === 'global') return state.hallName;
  if (type === 'dm') return getName(id);
  const g = state.groups.get(id);
  return g ? g.name : '群聊';
}

function roomSub(type, id) {
  if (type === 'global') {
    const n = state.online.size;
    return n ? `${n} 人在线` : '';
  }
  if (type === 'dm') {
    return state.online.has(id) ? '在线' : '离线';
  }
  const g = state.groups.get(id);
  if (!g) return '';
  const on = g.members.filter((m) => state.online.has(m)).length;
  return `${g.memberNames.join('、')}（${on}/${g.members.length} 在线）`;
}

