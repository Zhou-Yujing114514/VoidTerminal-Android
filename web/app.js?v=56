/* ============ 发送 ============ */
async function sendMsg() {
  if (sending) return;
  const input = $('msg-input');
  const content = sanitizeStr(input.value).trim();
  const hasImages = msgDraftImages.length > 0;
  if (!content && !hasImages) return;
  const { type, id } = state.activeRoom;

  const draftText = input.value;
  const draftImgs = msgDraftImages.slice();

  input.value = '';
  input.style.height = 'auto';
  msgDraftImages = [];
  renderDraftImages();

  sending = true;
  try {
    let images = [];
    if (hasImages) {
      for (const data of draftImgs) {
        const res = await fetch('/api/upload-msg-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: state.token, data }),
        });
        let d = null;
        try { d = await res.json(); } catch {}
        if (!res.ok || !d || !d.ok) throw new Error((d && d.error) || '图片上传失败');
        images.push(d.url);
      }
    }

    const payload = { type, content };
    if (type === 'dm') payload.to = id;
    else if (type === 'group') payload.gid = id;
    if (images.length) payload.images = images;

    state.ws.send(JSON.stringify(payload));
    pendingScrollBottom = true;
    input.blur();
    // 发送消息后清除输入状态
    if (state.typingTimer) { clearTimeout(state.typingTimer); state.typingTimer = null; }
  } catch (e) {
    toast(e.message || '发送失败');
    input.value = draftText;
    msgDraftImages = draftImgs;
    renderDraftImages();
  } finally {
    sending = false;
  }
}

