/* ============ 朋友圈 ============ */
let momentDraftImages = [];
let commentTargetMid = null;
let msgDraftImages = [];
let recallTarget = null;
let longPressAt = 0;
let pendingScrollBottom = false;
let sending = false;

function openMoments() {
  renderMoments();
  $('moments-view').classList.remove('hidden');
}

function closeMoments() {
  $('moments-view').classList.add('hidden');
}

function renderMoments() {
  const box = $('moments-list');
  box.textContent = '';
  const list = [...state.moments].sort((a, b) => b.time - a.time);
  if (!list.length) {
    box.appendChild(el('div', 'moment-empty', '还没有朋友圈，快来发布第一条吧'));
    return;
  }
  for (const m of list) box.appendChild(momentCardHTML(m));
}

function momentCardHTML(m) {
  const card = el('div', 'moment-card');
  const head = el('div', 'moment-head');
  head.appendChild(avatarEl(m.authorName || '?', m.authorAvatar || ''));
  const info = el('div', 'moment-info');
  info.appendChild(el('div', 'moment-name', m.authorName || '未知'));
  info.appendChild(el('div', 'moment-time', fmtDay(m.time) + ' ' + fmtTime(m.time)));
  head.appendChild(info);
  card.appendChild(head);

  if (m.text) {
    const t = el('div', 'moment-text');
    t.textContent = m.text;
    card.appendChild(t);
  }
  if (m.images && m.images.length) {
    const grid = el('div', 'moment-grid' + (m.images.length === 1 ? ' single' : ''));
    for (const url of m.images) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.onclick = () => window.open(url, '_blank');
      grid.appendChild(img);
    }
    card.appendChild(grid);
  }

  const actions = el('div', 'moment-actions');
  const likeCount = (m.likes || []).length;
  const liked = (m.likes || []).includes(state.me.id);
  const likeBtn = el('button', 'moment-btn' + (liked ? ' liked' : ''), '赞' + (likeCount ? ' ' + likeCount : ''));
  likeBtn.onclick = () => state.ws.send(JSON.stringify({ type: 'moment-like', mid: m.id }));
  actions.appendChild(likeBtn);

  const commentBtn = el('button', 'moment-btn', '评论');
  commentBtn.onclick = () => openCommentModal(m.id);
  actions.appendChild(commentBtn);

  if (m.author === state.me.id) {
    const delBtn = el('button', 'moment-btn del', '删除');
    delBtn.onclick = () => {
      if (confirm('确定删除这条朋友圈吗？')) state.ws.send(JSON.stringify({ type: 'moment-delete', mid: m.id }));
    };
    actions.appendChild(delBtn);
  }
  card.appendChild(actions);

  const comments = el('div', 'moment-comments');
  for (const c of (m.comments || [])) {
    const cr = el('div', 'moment-comment');
    cr.appendChild(el('span', 'c-name', (c.authorName || '未知') + ':'));
    cr.appendChild(el('span', 'c-text', c.text));
    if (c.author === state.me.id) {
      const del = el('button', 'c-del', '删除');
      del.onclick = () => state.ws.send(JSON.stringify({ type: 'moment-comment-delete', mid: m.id, cid: c.id }));
      cr.appendChild(del);
    }
    comments.appendChild(cr);
  }
  card.appendChild(comments);

  return card;
}

