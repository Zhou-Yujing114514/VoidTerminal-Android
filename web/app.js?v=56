// 全局函数：处理群申请按钮点击
function applyGroup(btn) {
  try {
    console.log('[群申请] 按钮被点击');
    const item = btn.closest('.search-result-item');
    if (!item) { toast('错误：找不到搜索结果项'); return; }
    const gid = item.dataset.gid;
    const gname = item.dataset.gname;
    console.log('[群申请] gid=', gid, 'gname=', gname);
    if (!gid) { toast('错误：缺少群ID'); return; }
    
    const wsObj = (typeof ws !== 'undefined') ? ws : (state ? state.ws : null);
    console.log('[群申请] wsObj=', wsObj, 'readyState=', wsObj ? wsObj.readyState : 'null');
    
    if (wsObj && wsObj.readyState === WebSocket.OPEN) {
      btn.textContent = '申请中...';
      btn.disabled = true;
      wsObj.send(JSON.stringify({ type: 'group-apply', gid: gid }));
      toast('已发送申请请求');
      console.log('[群申请] 消息已发送');
    } else {
      toast('连接未就绪，请稍后重试');
    }
  } catch(e) {
    console.error('[群申请] 错误:', e);
    toast('出错了：' + e.message);
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const searchGroupBtn = document.getElementById('search-group-btn');
  const searchGroupModal = document.getElementById('search-group-modal');
  const searchGroupInput = document.getElementById('search-group-input');
  const searchGroupSubmit = document.getElementById('search-group-submit');
  const searchGroupResults = document.getElementById('search-group-results');

  if (searchGroupBtn) {
    searchGroupBtn.addEventListener('click', function() {
      searchGroupModal.classList.remove('hidden');
      searchGroupInput.value = '';
      searchGroupResults.innerHTML = '';
      searchGroupInput.focus();
    });
  }

  if (searchGroupSubmit) {
    searchGroupSubmit.addEventListener('click', doSearchGroup);
    searchGroupInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') doSearchGroup();
    });
  }

  function doSearchGroup() {
    const keyword = searchGroupInput.value.trim();
    if (!keyword) {
      searchGroupResults.innerHTML = '<div class="search-empty">请输入关键词</div>';
      return;
    }
    searchGroupResults.innerHTML = '<div class="search-empty">搜索中...</div>';
    fetch('/api/search-groups?keyword=' + encodeURIComponent(keyword))
      .then(r => r.json())
      .then(data => {
        const groups = data.groups || [];
        if (groups.length === 0) {
          searchGroupResults.innerHTML = '<div class="search-empty">未找到相关群聊</div>';
          return;
        }
        searchGroupResults.innerHTML = groups.map(g => {
          const gname = escapeHtml(g.name || '');
          const ownerName = escapeHtml(g.ownerName || '未知');
          const avatarChar = escapeHtml((g.name || '?').charAt(0));
          return `
            <div class="search-result-item" data-gid="${escapeHtml(g.id)}" data-gname="${gname}">
              <div class="search-result-avatar">${avatarChar}</div>
              <div class="search-result-info">
                <div class="search-result-name">${gname}</div>
                <div class="search-result-sub">${escapeHtml(String(g.memberCount || 0))}人 · 群主: ${ownerName}</div>
              </div>
              <button class="search-apply-btn" onclick="applyGroup(this)">申请加入</button>
            </div>
          `;
        }).join('');
      })
      .catch(err => {
        searchGroupResults.innerHTML = '<div class="search-empty">搜索失败: ' + escapeHtml(err.message) + '</div>';
      });
  }
});

// 群申请相关消息处理（在原有消息处理中添加）
const origOnMessage = ws ? ws.onmessage : null;
// 注意：这里通过事件监听方式添加，不覆盖原有处理
document.addEventListener('DOMContentLoaded', function() {
  // 等待ws初始化后添加监听
  const checkWs = setInterval(function() {
    if (typeof ws !== 'undefined' && ws) {
      ws.addEventListener('message', function(event) {
        try {
          const data = JSON.parse(event.data);
          if (data.type === 'group-apply-sent') {
            // 申请发送成功
            toast('申请已发送，请等待群主审批');
            // 更新搜索结果中的按钮状态
            const btns = document.querySelectorAll('.search-apply-btn');
            btns.forEach(b => {
              if (b.textContent === '申请中...') {
                b.textContent = '已申请';
                b.disabled = true;
              }
            });
          } else if (data.type === 'group-apply-accepted') {
            toast('你已成功加入群聊「' + (data.group ? data.group.name : '') + '」');
            setTimeout(() => location.reload(), 1500);
          } else if (data.type === 'group-apply-rejected') {
            toast('你的入群申请被拒绝了');
            // 重置按钮状态
            const btns = document.querySelectorAll('.search-apply-btn');
            btns.forEach(b => {
              if (b.textContent === '申请中...' || b.textContent === '已申请') {
                b.textContent = '申请加入';
                b.disabled = false;
              }
            });
          } else if (data.type === 'error' && data.error) {
            console.log('[额外监听器] 收到error:', data.error);
            // 错误通知
            toast(data.error);
            // 重置按钮状态
            setTimeout(() => {
              const btns = document.querySelectorAll('.search-apply-btn');
              btns.forEach(b => {
                if (b.textContent.includes('申请中') || b.disabled) {
                  b.textContent = '申请加入';
                  b.disabled = false;
                }
              });
            }, 100);
          } else if (data.type === 'group-apply-request') {
            // 群主收到申请通知 - 已在主消息处理中处理
          }
        } catch(e) {}
      });
      clearInterval(checkWs);
    }
  }, 500);


});


