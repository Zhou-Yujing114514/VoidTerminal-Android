const AVATAR_COLORS = [
  'linear-gradient(135deg,#3b82f6,#8b5cf6)',
  'linear-gradient(135deg,#ef4444,#f97316)',
  'linear-gradient(135deg,#10b981,#06b6d4)',
  'linear-gradient(135deg,#f59e0b,#ef4444)',
  'linear-gradient(135deg,#8b5cf6,#ec4899)',
  'linear-gradient(135deg,#14b8a6,#3b82f6)',
];

function avatarStyle(name) {
  let h = 0;
  for (const c of name) h = (h * 31 + c.codePointAt(0)) % AVATAR_COLORS.length;
  return AVATAR_COLORS[h];
}

function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}

function avatarEl(name, url, cls) {
  const av = el('div', 'avatar' + (cls ? ' ' + cls : ''), (name || '?')[0].toUpperCase());
  if (url) {
    av.textContent = '';
    av.style.backgroundImage = `url(${url})`;
    av.style.backgroundSize = 'cover';
    av.style.backgroundPosition = 'center';
  } else {
    av.style.background = avatarStyle(name || '?');
  }
  return av;
}

function fmtTime(ts) {
  const d = new Date(ts);
  const p = (n) => String(n).padStart(2, '0');
  return `${p(d.getHours())}:${p(d.getMinutes())}`;
}

function fmtDay(ts) {
  const d = new Date(ts);
  return `${d.getMonth() + 1}月${d.getDate()}日`;
}

function roomKeyStr(type, id) {
  if (type === 'global') return 'global';
  return (type === 'dm' ? 'dm:' : 'g:') + id;
}

function toast(text) {
  const t = $('toast');
  t.textContent = text;
  t.classList.remove('hidden');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.add('hidden'), 2600);
}

/* ============ 视图切换 ============ */
function showAuth() {
  $('view-auth').classList.remove('hidden');
  $('view-chat').classList.add('hidden');
}
function logoutLocal() {
  state.token = '';
  api('/api/logout', {});
