      modalBox.appendChild(btn);
    }
  }

  // 监听群设置打开
  const observer = new MutationObserver(() => {
    if (state.activeRoom.type === 'group') {
      addGroupAnnouncementButton();
    }
  });
  
  // 群设置按钮点击时也尝试添加
