async function uploadAvatar(file) {
  if (!file || !/^image\//.test(file.type)) { toast('请选择图片文件'); return; }
  if (file.size > 5 * 1024 * 1024) { toast('图片不能超过 5MB'); return; }
  toast('正在上传…');
  try {
    const data = await resizeImage(file, 256);
    const res = await api('/api/avatar', { token: state.token, data });
    if (!res.ok) { toast(res.error || '上传失败'); return; }
    state.me.avatar = res.avatar;
    state.avatarMap.set(state.me.id, res.avatar);
    renderMeAvatar();
    renderConvList();
    renderMessages();
    toast('头像已更新');
  } catch (e) {
    toast('头像上传失败：' + e.message);
  }
}

function resizeImage(file, max) {
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onload = () => {
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, max / Math.max(img.width, img.height));
        const w = Math.max(1, Math.round(img.width * scale));
        const h = Math.max(1, Math.round(img.height * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', 0.85).split(',')[1]);
      };
      img.onerror = () => reject(new Error('无法读取图片'));
      img.src = fr.result;
    };
    fr.onerror = () => reject(new Error('无法读取文件'));
    fr.readAsDataURL(file);
  });
}

