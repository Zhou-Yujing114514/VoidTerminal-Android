'use strict';

const $ = (id) => document.getElementById(id);

const THEMES = { dark: '#0f1117', light: '#f4f6f9' };

function applyTheme(t) {
  document.documentElement.dataset.theme = t;
  localStorage.setItem('chat_theme', t);
  document.querySelector('meta[name="theme-color"]').setAttribute('content', THEMES[t] || THEMES.dark);
}
function toggleTheme() {
  const cur = document.documentElement.dataset.theme || 'dark';
  applyTheme(cur === 'dark' ? 'light' : 'dark');
  renderThemeMenuIcon();
}
function renderThemeMenuIcon() {
  const icon = $('theme-menu-icon');
  if (!icon) return;
  const cur = document.documentElement.dataset.theme || 'dark';
  icon.textContent = cur === 'dark' ? '☾' : '☀';
}

const FONT_SIZES = { sm: '小', md: '标准', lg: '大', xl: '特大' };
function applyFontSize(size) {
  const s = FONT_SIZES[size] ? size : 'md';
  document.documentElement.dataset.font = s === 'md' ? '' : s;
  localStorage.setItem('chat_font', s);
  renderFontIcon();
}
function renderFontIcon() {
  const icon = $('font-size-icon');
  if (!icon) return;
  const cur = document.documentElement.dataset.font || 'md';
  icon.textContent = FONT_SIZES[cur];
}
function renderFontOptions() {
  const cur = document.documentElement.dataset.font || 'md';
  document.querySelectorAll('.fs-opt').forEach((o) => {
    o.classList.toggle('active', o.dataset.size === cur);
  });
}
function isFullscreen() {
  return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
}
async function toggleFullscreen() {
  const el = document.documentElement;
  try {
    if (isFullscreen()) {
      if (document.exitFullscreen) await document.exitFullscreen();
      else if (document.webkitExitFullscreen) await document.webkitExitFullscreen();
      else if (document.msExitFullscreen) await document.msExitFullscreen();
    } else {
      if (el.requestFullscreen) await el.requestFullscreen();
      else if (el.webkitRequestFullscreen) await el.webkitRequestFullscreen();
      else if (el.msRequestFullscreen) await el.msRequestFullscreen();
    }
  } catch (e) {
    toast('全屏切换失败：' + e.message);
  }
  renderFullscreenIcon();
}
function renderFullscreenIcon() {
  const icon = $('fullscreen-icon');
  if (!icon) return;
  const on = isFullscreen();
  icon.textContent = on ? '\u2B22' : '\u2B21';
  icon.classList.toggle('fs-on', on);
}



let autoFsArmed = false;
function tryFullscreen() {
  const el = document.documentElement;
  if (el.requestFullscreen) return el.requestFullscreen();
  if (el.webkitRequestFullscreen) {
    return new Promise((res, rej) => { el.webkitRequestFullscreen(() => res()); });
  }
  if (el.msRequestFullscreen) return el.msRequestFullscreen();
  return Promise.reject(new Error('unsupported'));
}
function armAutoFullscreen() {
  if (autoFsArmed || isFullscreen()) return;
  autoFsArmed = true;
  document.addEventListener('pointerdown', function onceFs() {
    autoFsArmed = false;
    tryFullscreen().catch(() => {}).finally(renderFullscreenIcon);
  }, { once: true });
}
function autoEnterFullscreen() {
  if (isFullscreen()) return;
  tryFullscreen()
    .catch(() => {})
    .finally(() => {
      if (!isFullscreen()) armAutoFullscreen();
      renderFullscreenIcon();
    });
}

