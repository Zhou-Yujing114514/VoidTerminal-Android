  function sendReadReceipt() {
    if (state.activeRoom.type !== 'dm') return;
    const msgs = currentMessages();
    if (!msgs.length) return;
    const lastMsg = msgs[msgs.length - 1];
    if (lastMsg.from !== state.me.id && lastMsg.id !== state.lastSentReadId) {
      state.lastSentReadId = lastMsg.id;
      state.ws.send(JSON.stringify({ type: 'read', to: state.activeRoom.id, msgId: lastMsg.id }));
