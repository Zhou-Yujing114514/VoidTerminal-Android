}

/* ============ dock 页面切换 ============ */
function switchDock(tab) {
  state.dockTab = tab;
  closeMoments();
  document.querySelectorAll('.page').forEach((p) => p.classList.remove('page-active'));
  $('page-' + tab).classList.add('page-active');
  document.querySelectorAll('.dock-item').forEach((b) => {
    b.classList.toggle('dock-active', b.dataset.dock === tab);
  });
  closeChatView();
}

function closeChatView() {
  if (state.showRequests) closeRequestPanel();
  state.showRequests = false;
  $('chat-view').classList.add('hidden');
  renderConvList();
  if (state.me) renderMessages();
}

/* ============ 认证 ============ */
async function api(path, body) {
  const res = await fetch(path, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  return res.json();
}

async function enterWithToken() {
  const data = await api('/api/me', { token: state.token });
  if (!data.ok) return false;
  state.me = data.user;
  return true;
}

async function onLogin(e) {
  e.preventDefault();
  const username = $('login-username').value.trim();
  const password = $('login-password').value;
  if (!username || !password) return;
  const data = await api('/api/login', { username, password });
  if (!data.ok) { $('login-msg').className = 'auth-msg'; $('login-msg').textContent = data.error; return; }
  state.token = data.token;
  state.me = data.user;
  enterChat();
}

async function onRegister(e) {
  e.preventDefault();
  const username = $('reg-username').value.trim();
  const password = $('reg-password').value;
  const password2 = $('reg-password2').value;
  if (password !== password2) { $('reg-msg').textContent = '两次输入的密码不一致'; return; }
  const data = await api('/api/register', { username, password, password2 });
  if (!data.ok) { $('reg-msg').textContent = data.error; return; }
  state.token = data.token;
  state.me = data.user;
  enterChat();
  // 推荐绑定认证器
  $('twofa-recommend-modal').classList.remove('hidden');
}

async function onTotpLogin(e) {
  e.preventDefault();
  const username = $('totp-username').value.trim();
  const code = $('totp-code').value.trim();
  if (!username || !code) return;
  const data = await api('/api/login-totp', { username, code });
  if (!data.ok) { $('totp-msg').className = 'auth-msg'; $('totp-msg').textContent = data.error; return; }
  state.token = data.token;
  state.me = data.user;
  enterChat();
}

/* ============ WebSocket ============ */
function connectWS() {
  const proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
  const ws = new WebSocket(proto + location.host + '/ws');
  state.ws = ws;

  ws.onopen = () => ws.send(JSON.stringify({ type: 'auth', token: state.token }));

  ws.onmessage = (ev) => {
    let msg;
    try { msg = JSON.parse(ev.data); } catch { return; }
    handleMsg(msg);
  };

  ws.onclose = () => {
    if (state.serverFull) {
      setTimeout(() => {
        state.serverFull = false;
        if (state.ws && state.me) connectWS();
      }, 30000);
      return;
    }
    if (state.ws === ws && state.me) setTimeout(() => { if (state.ws && state.me) connectWS(); }, 2000);
  };
}

function rebuildNameMap() {
  state.nameMap.clear();
  state.avatarMap.clear();
  state.nameMap.set(state.me.id, state.me.username);
  if (state.me.avatar) state.avatarMap.set(state.me.id, state.me.avatar);
  for (const u of state.online.values()) {
    state.nameMap.set(u.id, u.username);
    if (u.avatar) state.avatarMap.set(u.id, u.avatar);
  }
  for (const u of state.friends.values()) {
    state.nameMap.set(u.id, u.username);
    if (u.avatar) state.avatarMap.set(u.id, u.avatar);
  }
  for (const g of state.groups.values()) {
    g.members.forEach((id, i) => state.nameMap.set(id, g.memberNames[i] || state.nameMap.get(id) || ('用户' + id.slice(1))));
    g.members.forEach((id, i) => { if (g.memberAvatars && g.memberAvatars[i]) state.avatarMap.set(id, g.memberAvatars[i]); });
  }
}

function getAvatar(id) {
  return state.avatarMap.get(id) || '';
}

function getName(id) {
  return state.nameMap.get(id) || ('用户' + id.slice(1));
}

let mentionList = [];
let mentionActive = -1;

function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function highlightMentions(text) {
  return escapeHtml(text).replace(/@([\u4e00-\u9fa5\w]+)/g, '<span class="mention">@$1</span>');
}
function currentMention() {
  const input = $('msg-input');
  const v = input.value;
  const cursor = input.selectionStart;
  if (state.activeRoom.type !== 'group') return null;
  const idx = v.lastIndexOf('@', cursor - 1);
  if (idx === -1) return null;
  const between = v.slice(idx + 1, cursor);
  if (/\s/.test(between)) return null;
  if (idx > 0 && !/\s/.test(v[idx - 1])) return null;
  return { start: idx, end: cursor, query: between };
}
function mentionMembers(query) {
  const g = state.groups.get(state.activeRoom.id);
  if (!g) return [];
  const q = String(query || '').toLowerCase();
  return (g.members || [])
    .map((id, i) => ({ id, name: g.memberNames[i] || getName(id), avatar: (g.memberAvatars && g.memberAvatars[i]) || getAvatar(id), bot: !!(g.memberBots && g.memberBots[i]) }))
    .filter((m) => !q || m.name.toLowerCase().includes(q));
}
function closeMentionPanel() {
  const panel = $('mention-panel');
  panel.classList.add('hidden');
  panel.textContent = '';
  mentionList = [];
  mentionActive = -1;
}
function renderMentionPanel() {
  const m = currentMention();
  const panel = $('mention-panel');
  if (!m) { closeMentionPanel(); return; }
  const members = mentionMembers(m.query);
  if (!members.length) { closeMentionPanel(); return; }
  mentionList = members;
  if (mentionActive < 0 || mentionActive >= members.length) mentionActive = 0;
  panel.textContent = '';
  members.forEach((mem, i) => {
    const btn = el('button', 'mention-item' + (i === mentionActive ? ' active' : ''));
    const av = avatarEl(mem.name, mem.avatar);
    av.style.width = '28px';
    av.style.height = '28px';
    btn.appendChild(av);
    const nm = el('span', '', mem.name);
    nm.style.flex = '1';
    btn.appendChild(nm);
    if (mem.bot) btn.appendChild(el('span', 'role-badge role-bot', 'BOT'));
    btn.onmousedown = (e) => { e.preventDefault(); pickMention(mem.name); };
    panel.appendChild(btn);
  });
  panel.classList.remove('hidden');
}
function pickMention(name) {
  const input = $('msg-input');
  const m = currentMention();
  if (!m) return;
  const insert = '@' + name + ' ';
  input.value = input.value.slice(0, m.start) + insert + input.value.slice(m.end);
  const pos = m.start + insert.length;
  input.setSelectionRange(pos, pos);
  closeMentionPanel();
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  input.focus();
}
function autoMention(name) {
  const input = $('msg-input');
  const v = input.value;
  const cursor = (input.selectionStart != null) ? input.selectionStart : v.length;
  const insert = '@' + name + ' ';
  input.value = v.slice(0, cursor) + insert + v.slice(cursor);
  const pos = cursor + insert.length;
  closeMentionPanel();
  input.focus();
  input.setSelectionRange(pos, pos);
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 120) + 'px';
}
function bindAvatarMention(av, name) {
  let startTime = 0, startX = 0, startY = 0, ok = false;
  const start = (e) => {
    if (e.touches && e.cancelable) e.preventDefault();
    const x = e.touches ? e.touches[0].clientX : e.clientX;
    const y = e.touches ? e.touches[0].clientY : e.clientY;
    startX = x; startY = y;
    startTime = Date.now();
    ok = true;
  };
  const move = (e) => {
    if (!ok) return;
    const x = e.touches ? e.touches[0].clientX : e.clientX;
    const y = e.touches ? e.touches[0].clientY : e.clientY;
    if (Math.abs(x - startX) > 10 || Math.abs(y - startY) > 10) ok = false;
  };
  const end = (e) => {
    if (ok && (Date.now() - startTime) >= 500) {
      if (e && e.cancelable) e.preventDefault();
      autoMention(name);
    }
    ok = false;
  };
  av.addEventListener('touchstart', start, { passive: false });
  av.addEventListener('touchmove', move, { passive: true });
  av.addEventListener('touchend', end);
  av.addEventListener('touchcancel', () => { ok = false; });
  av.addEventListener('mousedown', start);
  av.addEventListener('mousemove', move);
  av.addEventListener('mouseup', end);
  av.addEventListener('mouseleave', () => { ok = false; });
  av.addEventListener('contextmenu', (e) => { e.preventDefault(); autoMention(name); });
  av.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); });
}
function moveMention(delta) {
  if (!mentionList.length) return;
  mentionActive = (mentionActive + delta + mentionList.length) % mentionList.length;
  renderMentionPanel();
}
function confirmMention() {
  if (mentionActive >= 0 && mentionList[mentionActive]) pickMention(mentionList[mentionActive].name);
}

function handleMsg(msg) {
  switch (msg.type) {
    case 'hello': {
      state.online.clear();
      state.friends = new Map((msg.friends || []).map((u) => [u.id, u]));
      state.groups = new Map((msg.groups || []).map((g) => [g.id, g]));
      if (msg.self && msg.self.avatar) {
        state.me.avatar = msg.self.avatar;
        renderMeAvatar();
      }
      state.globalMsgs = msg.globalMsgs || [];
      state.dmHist = new Map();
      for (const [key, msgs] of Object.entries(msg.dmRooms || {})) {
        const peer = key.split('_').find((id) => id !== state.me.id);
        if (peer) state.dmHist.set(peer, msgs);
      }
      state.groupHist = new Map();
      for (const [gid, msgs] of Object.entries(msg.groupMsgs || {})) {
        state.groupHist.set(gid, msgs);
      }
      state.unread = new Map();
      state.requests = msg.pendingRequests || [];
      state.moments = msg.moments || [];
      state.isAdmin = !!msg.isAdmin;
      if (msg.hallName) state.hallName = msg.hallName;
      $('admin-btn').classList.toggle('hidden', !state.isAdmin);
      rebuildNameMap();
      renderConvList();
      renderRequestEntry();
      renderMessages();
      break;
    }
    case 'moments': {
      state.moments = msg.moments || [];
      if (!$('moments-view').classList.contains('hidden')) renderMoments();
      break;
    }
    case 'presence': {
      const before = new Set(state.online.keys());
      const now = new Map(msg.online.map((u) => [u.id, u]));
      state.online = now;
      for (const u of now.values()) if (u.avatar) state.avatarMap.set(u.id, u.avatar);
      rebuildNameMap();
      const joined = [...now.keys()].filter((id) => !before.has(id) && id !== state.me.id);
      const left = [...before.keys()].filter((id) => !now.has(id));
      renderConvList();
      renderMessages();
      for (const id of joined) pushSystem(`「${getName(id)}」上线了`);
      for (const id of left) pushSystem(`「${getName(id)}」离线了`);
      break;
    }
    case 'global': {
      state.globalMsgs.push({ id: msg.id, from: msg.from, fromName: msg.fromName, fromAvatar: msg.fromAvatar, fromRole: msg.fromRole, content: msg.content, images: msg.images, time: msg.time });
      state.nameMap.set(msg.from, msg.fromName);
      if (msg.fromAvatar) state.avatarMap.set(msg.from, msg.fromAvatar);
      if (state.activeRoom.type === 'global') renderMessages();
      else bumpUnread('global');
      updateConvPreview();
      break;
    }
    case 'dm': {
      const peer = msg.from === state.me.id ? msg.to : msg.from;
      const hist = state.dmHist.get(peer) || [];
      hist.push({ id: msg.id, from: msg.from, fromName: msg.fromName, fromAvatar: msg.fromAvatar, fromRole: msg.fromRole, content: msg.content, images: msg.images, time: msg.time });
      state.dmHist.set(peer, hist);
      state.nameMap.set(msg.from, msg.fromName);
      if (msg.fromAvatar) state.avatarMap.set(msg.from, msg.fromAvatar);
      if (state.activeRoom.type === 'dm' && state.activeRoom.id === peer) {
        renderMessages();
      } else if (msg.from !== state.me.id) {
        bumpUnread('dm:' + peer);
      }
      renderConvList();
      break;
    }
    case 'group': {
      const hist = state.groupHist.get(msg.gid) || [];
      hist.push({ id: msg.id, from: msg.from, fromName: msg.fromName, fromAvatar: msg.fromAvatar, fromRole: msg.fromRole, content: msg.content, images: msg.images, time: msg.time });
      state.groupHist.set(msg.gid, hist);
      state.nameMap.set(msg.from, msg.fromName);
      if (msg.fromAvatar) state.avatarMap.set(msg.from, msg.fromAvatar);
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        renderMessages();
      } else if (msg.from !== state.me.id) {
        bumpUnread('g:' + msg.gid);
      }
      renderConvList();
      break;
    }
    case 'group-created': {
      state.groups.set(msg.group.id, msg.group);
      rebuildNameMap();
      renderConvList();
      renderGroupPicker();
      openRoom({ type: 'group', id: msg.group.id });
      toast(`群「${msg.group.name}」创建成功`);
      break;
    }
    case 'group-apply-request': {
      const apply = msg.apply;
      if (!apply) break;
      const g = state.groups.get(apply.gid);
      apply.groupName = g ? g.name : (apply.groupName || '未知群');
      apply.fromAvatar = state.avatarMap.get(apply.from) || '';
      if (!state.groupRequests.some((r) => r.id === apply.id)) {
        state.groupRequests.push(apply);
      }
      renderGroupRequestEntry();
      renderGroupRequestList();
      toast(`「${apply.fromName}」申请加入「${apply.groupName}」`);
      break;
    }
    case 'friend-request': {
      state.requests.push(msg.request);
      renderRequestEntry();
      renderRequestList();
      if (state.showRequests) {
        $('chat-sub').textContent = `${state.requests.length} 个待处理申请`;
      }
      toast(`「${msg.request.fromName}」请求添加你为好友`);
      break;
    }
    case 'request-sent': {
      const fm = $('friend-msg');
      if (msg.ok) {
        fm.textContent = '';
        $('friend-username').value = '';
        fm.className = 'auth-msg ok';
        fm.textContent = '验证请求已发送，等待对方通过';
      } else {
        fm.className = 'auth-msg';
        fm.textContent = msg.error;
      }
      break;
    }
    case 'request-respond': {
      if (msg.action === 'accept') {
        toast(`「${msg.fromName}」通过了你的好友验证`);
      } else {
        toast(`「${msg.fromName}」拒绝了你的好友验证`);
      }
      break;
    }
    case 'friend-update': {
      state.friends = new Map((msg.friends || []).map((u) => [u.id, u]));
      rebuildNameMap();
      renderConvList();
      renderGroupPicker();
      break;
    }
    case 'banned': {
      toast(msg.error || '账号已被封禁');
      logoutLocal();
      break;
    }
    case 'kicked': {
      toast(msg.error || '你已被移出服务器');
      logoutLocal();
      break;
    }
    case 'group-renamed': {
      const g = state.groups.get(msg.gid);
      if (g) { g.name = msg.group.name; state.groups.set(msg.gid, g); }
      renderConvList();
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        $('chat-name').textContent = msg.group.name;
      }
      toast(`群已更名为「${msg.group.name}」`);
      break;
    }
    case 'group-member-removed': {
      if (msg.userId === state.me.id) {
        state.groups.delete(msg.gid);
        state.groupHist.delete(msg.gid);
        if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
          openRoom({ type: 'global', id: null });
        }
        renderConvList();
        toast('你已被移出该群');
      } else {
        const g = state.groups.get(msg.gid);
        if (g) {
          g.members = msg.group.members;
          g.memberNames = msg.group.memberNames;
          g.memberAvatars = msg.group.memberAvatars;
          g.memberBots = msg.group.memberBots;
          state.groups.set(msg.gid, g);
        }
        rebuildNameMap();
        renderConvList();
        renderMessages();
      }
      break;
    }
    case 'group-member-left': {
      const g = state.groups.get(msg.gid);
      if (g) {
        g.members = msg.group.members;
        g.memberNames = msg.group.memberNames;
        g.memberAvatars = msg.group.memberAvatars;
        g.memberBots = msg.group.memberBots;
        state.groups.set(msg.gid, g);
      }
      rebuildNameMap();
      renderConvList();
      renderMessages();
      break;
    }
    case 'group-left': {
      state.groups.delete(msg.gid);
      state.groupHist.delete(msg.gid);
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        openRoom({ type: 'global', id: null });
      }
      renderConvList();
      toast('你已退出群聊');
      break;
    }
    case 'group-members-added': {
      const g = state.groups.get(msg.gid);
      if (g) {
        g.members = msg.group.members;
        g.memberNames = msg.group.memberNames;
        g.memberAvatars = msg.group.memberAvatars;
        g.memberBots = msg.group.memberBots;
        state.groups.set(msg.gid, g);
      } else {
        state.groups.set(msg.gid, msg.group);
      }
      rebuildNameMap();
      renderConvList();
      renderMessages();
      if (msg.added && msg.added.includes(state.me.id)) toast('你已被拉入群聊');
      break;
    }
    case 'group-removed': {
      state.groups.delete(msg.gid);
      state.groupHist.delete(msg.gid);
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        openRoom({ type: 'global', id: null });
      }
      renderConvList();
      toast(msg.error || '你已被移出群聊');
      break;
    }
    case 'group-dissolved': {
      state.groups.delete(msg.gid);
      state.groupHist.delete(msg.gid);
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        openRoom({ type: 'global', id: null });
      }
      renderConvList();
      toast('群已被解散');
      break;
    }
    case 'friend-removed': {
      state.friends.delete(msg.from);
      if (state.activeRoom.type === 'dm' && state.activeRoom.id === msg.from) {
        openRoom({ type: 'global', id: null });
      }
      renderConvList();
      toast(`「${msg.fromName}」已删除你为联系人`);
      break;
    }
    case 'group-avatar-updated': {
      const g = state.groups.get(msg.gid);
      if (g) { g.avatar = msg.avatar; state.groups.set(msg.gid, g); }
      renderConvList();
      if (state.activeRoom.type === 'group' && state.activeRoom.id === msg.gid) {
        renderGsAvatar();
      }
      break;
    }
    case 'hall-renamed': {
      state.hallName = msg.hallName;
      if (state.activeRoom.type === 'global') $('chat-name').textContent = state.hallName;
      renderConvList();
      break;
    }
    case 'hall-cleared': {
      state.globalMsgs = [];
      if (state.activeRoom.type === 'global') renderMessages();
      break;
    }
    case 'recalled': {
      const { room, id } = msg;
      if (room === 'global') {
        state.globalMsgs = state.globalMsgs.filter((m) => m.id !== id);
      } else if (room === 'dm') {
        const peer = msg.from === state.me.id ? msg.to : msg.from;
        const hist = state.dmHist.get(peer);
        if (hist) state.dmHist.set(peer, hist.filter((m) => m.id !== id));
      } else if (room === 'group') {
        const gid = msg.gid;
        const hist = state.groupHist.get(gid);
        if (hist) state.groupHist.set(gid, hist.filter((m) => m.id !== id));
      }
      renderMessages();
      renderConvList();
      break;
    }
    case 'typing': {
      const from = msg.from;
      if (state.activeRoom.type === 'dm' && state.activeRoom.id === from) {
        state.typingPeer = from;
        state.typingTimer = setTimeout(() => { state.typingPeer = null; renderTypingStatus(); }, 3000);
        renderTypingStatus();
      }
      break;
    }
    case 'read': {
      const from = msg.from;
      const msgId = msg.msgId;
      if (state.activeRoom.type === 'dm' && state.activeRoom.id === from) {
        state.lastReadMsgId = msgId;
        // 查找消息时间戳
        const msgs = currentMessages();
        for (const m of msgs) {
          if (m.id === msgId) {
            state.lastReadTime = m.time;
            break;
          }
        }
        renderMessages();
      }
      break;
    }
    case 'group_announcement': {
      const gid = msg.gid;
      const text = msg.text;
      if (!state.groupAnnouncements) state.groupAnnouncements = {};
      state.groupAnnouncements[gid] = { text, time: msg.time || Date.now() };
      if (state.activeRoom.type === 'group' && state.activeRoom.id === gid) {
        renderGroupAnnouncement();
        toast('群公告: ' + text);
      }
      break;
    }
    case 'error':
      console.log('[主消息] 收到error:', msg.error);
      // 如果是群申请相关错误，重置按钮状态
      if (msg.error && (msg.error.includes('群') || msg.error.includes('申请'))) {
        setTimeout(() => {
          const btns = document.querySelectorAll('.search-apply-btn');
          btns.forEach(b => {
            if (b.textContent.includes('申请中') || b.disabled) {
              b.textContent = '申请加入';
              b.disabled = false;
            }
          });
        }, 100);
      }
      if (msg.error === '认证失败') {
        state.token = '';
        state.me = null;
        showAuth();
      } else {
        toast(msg.error);
        if (msg.error.includes('在线人数已达上限')) {
          state.serverFull = true;
        }
      }
      break;
  }
}

