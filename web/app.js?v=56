      const messages = document.getElementById('messages');
      if (messages && messages.parentNode) {
        messages.parentNode.insertBefore(el, messages);
      }
    }
    if (state.activeRoom.type === 'group' && state.groupAnnouncements && state.groupAnnouncements[state.activeRoom.id]) {
      const ann = state.groupAnnouncements[state.activeRoom.id];
      el.textContent = '📢 群公告: ' + ann.text;
