  renderMomentImages();
  openModal('moment-post-modal');
  setTimeout(() => $('moment-text').focus(), 50);
}

function sanitizeStr(str) {
  const s = String(str == null ? '' : str);
  return (typeof s.toWellFormed === 'function') ? s.toWellFormed() : s;
}

async function submitMoment() {
  const text = sanitizeStr($('moment-text').value).trim();
  if (!text && !momentDraftImages.length) { $('moment-msg').textContent = '内容不能为空'; return; }
  $('moment-msg').textContent = '';
  $('moment-msg').className = 'auth-msg';
  $('moment-submit').disabled = true;
  try {
    const res = await fetch('/api/moment-post', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token: state.token, text, images: momentDraftImages }),
    });
    let data = null;
    try { data = await res.json(); } catch {}
    if (!res.ok || !data || !data.ok) {
      $('moment-msg').textContent = (data && data.error) || ('发布失败（HTTP ' + res.status + '），可能是图片过大，请尝试压缩或减少图片');
      $('moment-submit').disabled = false;
      return;
    }
    closeModal('moment-post-modal');
    $('moment-submit').disabled = false;
    toast('发布成功');
  } catch (e) {
    $('moment-msg').textContent = '发布失败：' + e.message + '（图片过大时请减少张数或改用小图）';
    $('moment-submit').disabled = false;
  }
}

/* ============ 渲染 ============ */
function renderMessages() {
  $('chat-sub').textContent = roomSub(state.activeRoom.type, state.activeRoom.id);
  const box = $('messages');
  const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 120;
  box.textContent = '';
  const msgs = currentMessages();
  let lastDay = '';
  for (const m of msgs) {
    if (m.from === 'system') {
      box.appendChild(el('div', 'system-row', m.content));
      continue;
    }
    if (state.activeRoom.type !== 'global') {
      const day = fmtDay(m.time);
      if (day !== lastDay) {
        box.appendChild(el('div', 'system-row', day));
        lastDay = day;
      }
    }
    const me = m.from === state.me.id;
    const senderName = m.fromName || getName(m.from) || ('用户' + (m.from || '').slice(1));
    const senderAvatar = m.fromAvatar || getAvatar(m.from);
    const row = el('div', 'msg-row ' + (me ? 'me' : 'other'));
    const av = avatarEl(senderName, senderAvatar);
    av.style.width = '36px';
    av.style.height = '36px';
    if (state.activeRoom.type === 'group' && !me && m.from !== 'system' && senderName) {
      bindAvatarMention(av, senderName);
    }
    const wrap = el('div', 'msg-wrap');
    const meta = el('div', 'msg-meta');
    meta.appendChild(el('span', 'msg-sender', me ? '我' : senderName));
    if (m.fromBot || senderName === 'DeepSeek') meta.appendChild(el('span', 'role-badge role-bot', 'BOT'));
    if (m.fromRole === 'admin') meta.appendChild(el('span', 'role-badge role-admin', '站长'));
    else if (state.activeRoom.type === 'group' && (state.groups.get(state.activeRoom.id) || {}).owner === m.from) {
      meta.appendChild(el('span', 'role-badge role-owner', '群主'));
    }
    meta.appendChild(el('span', 'msg-time', fmtTime(m.time)));
    // 已读/未读状态（仅私聊，仅自己发的消息）
    if (me && state.activeRoom.type === 'dm') {
      const isRead = (state.lastReadTime && m.time <= state.lastReadTime) || (state.lastReadMsgId && m.id === state.lastReadMsgId);
      if (isRead) {
        meta.appendChild(el('span', 'msg-read', '已读'));
      } else if (!m.recalled) {
        meta.appendChild(el('span', 'msg-unread', '未读'));
      }
    }
    wrap.appendChild(meta);
    const bubble = el('div', 'msg-bubble' + (me && state.me.id === 'u3' ? ' bubble-blue' : ''));
    // 检测content是否是纯图片URL（兼容旧消息格式）
    const isImgUrl = (u) => typeof u === 'string' && /^(https?:\/\/[^/]+)?\/(msgimg|uploads|moments|stickers)\/.+\.(png|jpg|jpeg|gif|webp)(\?.*)?$/i.test(u.trim());
    let contentImages = [];
    if (m.content && isImgUrl(m.content) && (!m.images || !m.images.length)) {
      contentImages = [m.content.trim()];
    }
    if (m.content && !contentImages.length) {
      const ts = document.createElement('span');
      ts.innerHTML = highlightMentions(m.content);
      bubble.appendChild(ts);
    }
    // 表情包
    const allImages = (m.images && m.images.length) ? m.images : contentImages;
    if (allImages.length) {
      const grid = el('div', 'msg-images' + (allImages.length === 1 ? ' single' : ''));
      for (const url of allImages) {
        const img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.onclick = () => { if (Date.now() - longPressAt < 500) return; openImagePreview(url); };
        grid.appendChild(img);
      }
      bubble.appendChild(grid);
    }
    wrap.appendChild(bubble);
    if (me && m.id) bindLongPress(row, (x, y) => showRecallMenu(m, x, y));
    row.appendChild(av);
    row.appendChild(wrap);
    box.appendChild(row);
  }
  if (pendingScrollBottom || nearBottom) {
    box.scrollTop = box.scrollHeight;
  }
  pendingScrollBottom = false;
}

function convItemHTML(room, opts) {
  const { name, preview, avatarText, avatarBg, avatarUrl, isGroup, nameTag } = opts;
  const item = el('button', 'conv-item ' + (isGroup ? 'group-item' : 'friend-item'));
  item.dataset.room = JSON.stringify(room);
  const av = avatarEl(avatarText, avatarUrl);
  av.classList.add('conv-avatar');
  if (!avatarUrl) av.style.background = avatarBg;
  const info = el('div', 'conv-info');
  const nameRow = el('div', 'conv-name');
  nameRow.textContent = name;
  if (nameTag) nameRow.appendChild(nameTag);
  info.appendChild(nameRow);
  info.appendChild(el('div', 'conv-preview', preview));
  item.appendChild(av);
  item.appendChild(info);
  const active = state.activeRoom.type === room.type && state.activeRoom.id === room.id;
  if (active) item.classList.add('active');
